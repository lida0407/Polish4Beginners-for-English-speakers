<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (dataExtractionRules). Anything not included is not
     transferred, so regenerable caches need no explicit exclude. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Progress and the user's own notes; both small, well within quota. -->
        <include domain="sharedpref" path="phrasebook.xml" />
        <include domain="file" path="word_notes.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="phrasebook.xml" />
        <include domain="file" path="word_notes.json" />
        <!-- A direct device-to-device move can afford the user's dictionary. -->
        <include domain="file" path="user_dictionary.json" />
    </device-transfer>
</data-extraction-rules>
