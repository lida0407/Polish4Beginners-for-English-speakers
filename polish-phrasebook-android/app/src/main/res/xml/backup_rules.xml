<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (allowBackup / fullBackupContent).
     Only what is listed here is backed up, so caches (gloss_cache.json,
     phrases_remote.json) are excluded simply by not being included. -->
<full-backup-content>
    <!-- Study progress, favourites, custom words and settings. -->
    <include domain="sharedpref" path="phrasebook.xml" />
</full-backup-content>
